{
  "root": true,
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": { "jsx": true }
  },
  "env": { "browser": true, "node": true, "es2022": true },
  "rules": {
    "no-console": ["error", { "allow": [] }]
  },
  "overrides": [
    {
      "comment": "lib/logger.js is the single approved place that may call console.* directly.",
      "files": ["lib/logger.js"],
      "rules": { "no-console": "off" }
    }
  ]
}
